<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Worktrax" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>

        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/line</item>
    </style>

    <!-- Small uppercase kicker / eyebrow label -->
    <style name="TextKicker">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>

    <style name="TextEyebrow" parent="TextKicker" />

    <!-- Display: serif, large, italic accent via spans in code. -->
    <style name="TextH1Serif">
        <item name="android:textSize">28.5sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="TextH1SerifItalic" parent="TextH1Serif">
        <item name="android:textStyle">italic</item>
    </style>

    <style name="TextHeroSerif">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextLogTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Section title (h2) -->
    <style name="TextH2">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextMuted">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>

    <style name="TextMono">
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Button base -->
    <style name="BtnBase">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Primary: btn_bg bg, btn_text text — main CTA -->
    <style name="BtnPrimary" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_primary</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <!-- Primary with arrow: btn_bg bg, btn_text text, right arrow -->
    <style name="BtnPrimaryArrow" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_primary</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_right</item>
        <item name="android:drawableTint">@color/btn_text</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <!-- Secondary: btn_bg bg, btn_text text, subtle border — secondary actions -->
    <style name="BtnSecondary" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_secondary</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <!-- Ghost: btn_bg bg, btn_text text — tertiary actions -->
    <style name="BtnGhost" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_ghost</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <!-- Danger: btn_bg bg, btn_text text — destructive actions -->
    <style name="BtnDanger" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_danger</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <!-- Outline Accent: btn_bg bg, btn_text text -->
    <style name="BtnOutlineAccent" parent="BtnBase">
        <item name="android:background">@drawable/shape_button_outline_accent</item>
        <item name="android:textColor">@color/btn_text</item>
    </style>

    <!-- Legacy aliases (keep for backward compat) -->
    <style name="BtnPillPrimary" parent="BtnPrimary" />
    <style name="BtnPillSecondary" parent="BtnSecondary" />
    <style name="BtnPillAccent" parent="BtnPrimary" />
</resources>
