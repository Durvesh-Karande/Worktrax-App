<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/overlay_scrim"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_border_card"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_playstore_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to"
            style="@style/TextKicker" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/worktrax_title"
            android:textSize="32sp"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:letterSpacing="-0.02" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginVertical="20dp"
            android:background="@color/accent" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/shape_field"
            android:hint="@string/enter_name_hint"
            android:inputType="textPersonName"
            android:imeOptions="actionDone"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_3"
            android:maxLines="1"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step1_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step1_desc"
            android:textSize="13sp"
            android:textColor="@color/ink_2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step2_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step2_desc"
            android:textSize="13sp"
            android:textColor="@color/ink_2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step3_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step3_desc"
            android:textSize="13sp"
            android:textColor="@color/ink_2" />

        <Button
            android:id="@+id/btn_get_started"
            style="@style/BtnPrimaryArrow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/get_started" />

        <Button
            android:id="@+id/btn_skip"
            style="@style/BtnGhost"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/skip_for_now" />
    </LinearLayout>
</LinearLayout>
