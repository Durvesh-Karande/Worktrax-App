<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- Top bar: back + step kicker + unit chip -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/shape_circle_card"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="@string/cd_back"
                app:tint="@color/ink" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="4 of 4" />

        <TextView
            android:id="@+id/tv_unit"
            style="@style/TextMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/weight_label" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_muscle_kicker"
                style="@style/TextKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="" />

            <TextView
                android:id="@+id/tv_exercise_name"
                style="@style/TextH1Serif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="" />

            <TextView
                android:id="@+id/tv_set_counter"
                style="@style/TextMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="Set 2 of 4 · enter values, then Next." />

            <TextView
                android:id="@+id/tv_previous_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="12sp"
                android:textColor="@color/ink_3"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ─── STRENGTH: reps + weight ─── -->
            <LinearLayout
                android:id="@+id/layout_strength_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/stepper_reps"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/stepper_weight"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <include
                    android:id="@+id/stepper_total_sets"
                    layout="@layout/view_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Warm-up toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp"
                    android:id="@+id/layout_warmup">

                    <TextView
                        style="@style/TextKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/warmup_label" />

                    <TextView
                        android:id="@+id/btn_warmup_toggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:text="OFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_3"
                        android:background="@drawable/shape_chip" />
                </LinearLayout>

                <!-- RPE selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp"
                    android:id="@+id/layout_rpe">

                    <TextView
                        style="@style/TextKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RPE" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_rpe_buttons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ─── BODYWEIGHT: reps only ─── -->
            <LinearLayout
                android:id="@+id/layout_bodyweight_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/sbw_reps"
                    layout="@layout/view_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <include
                    android:id="@+id/sbw_total_sets"
                    layout="@layout/view_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ─── CARDIO: min + sec + distance ─── -->
            <LinearLayout
                android:id="@+id/layout_cardio_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sc_duration_hr"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/sc_duration_min"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/sc_duration_sec"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <include
                    android:id="@+id/sc_distance"
                    layout="@layout/view_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ─── HIIT: duration (hr + min + sec) ─── -->
            <LinearLayout
                android:id="@+id/layout_aerobic_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/shiit_hr"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/shiit_min"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/shiit_sec"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── TIMED: duration (hr + min + sec) + total sets ─── -->
            <LinearLayout
                android:id="@+id/layout_timed_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/st_hr"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/st_min"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/st_sec"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <include
                    android:id="@+id/st_total_sets"
                    layout="@layout/view_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ─── YOGA: duration (hr + min + sec) ─── -->
            <LinearLayout
                android:id="@+id/layout_yoga_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sy_hr"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/sy_min"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent" />

                    <include
                        android:id="@+id/sy_sec"
                        layout="@layout/view_stepper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Workout timer (timed / cardio / yoga / hiit) -->
            <FrameLayout
                android:id="@+id/container_workout_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/shape_field"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/work_timer_label" />

                    <TextView
                        android:id="@+id/tv_workout_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="48sp"
                        android:fontFamily="serif"
                        android:textColor="@color/accent"
                        android:text="00:00" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_timer_start"
                            style="@style/BtnPrimary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/start_label" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <Button
                            android:id="@+id/btn_timer_stop"
                            style="@style/BtnSecondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stop_label" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Rest timer -->
            <FrameLayout
                android:id="@+id/container_rest_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/shape_field"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextKicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rest_label" />

                    <TextView
                        android:id="@+id/tv_rest_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="36sp"
                        android:fontFamily="serif"
                        android:textColor="@color/accent"
                        android:text="60" />

                    <Button
                        android:id="@+id/btn_skip_rest"
                        style="@style/BtnGhost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/skip_label" />
                </LinearLayout>
            </FrameLayout>

            <!-- Set log table -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/shape_field">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tbl_col_set"
                        style="@style/TextKicker"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="@string/set_label" />
                    <TextView
                        android:id="@+id/tbl_col_left"
                        style="@style/TextKicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reps_label" />
                    <TextView
                        android:id="@+id/tbl_col_right"
                        style="@style/TextKicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/weight_label" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/ink_4" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/list_logged_sets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Button row: Done (secondary) + Next set (primary) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_finish_workout"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/done_label" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_log_set"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/next_set_label" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_exercise"
                style="@style/BtnOutlineAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/add_exercise_label" />

            <Button
                android:id="@+id/btn_undo"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/undo_label" />

            <Button
                android:id="@+id/btn_plate_calc"
                style="@style/BtnGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/plate_calculator" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/include_banner"
        layout="@layout/view_banner_ad" />
</LinearLayout>
