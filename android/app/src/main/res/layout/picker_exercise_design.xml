<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <include
        android:id="@+id/include_top_bar"
        layout="@layout/view_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tv_exercise_kicker"
            style="@style/TextKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target muscle" />

        <TextView
            style="@style/TextH1Serif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/picker_exercise_header" />
    </LinearLayout>

    <!-- Inline muscle chip row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_muscle_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Search box -->
    <LinearLayout
        android:id="@+id/layout_search_wrap"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_search_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:gravity="center_vertical"
        android:visibility="visible">
 
         <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:textColorHint="@color/ink_3"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <FrameLayout
            android:id="@+id/btn_clear_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/cd_clear_search"
                app:tint="@color/ink_3" />
        </FrameLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/cd_search"
            app:tint="@color/ink_3" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_custom_exercise"
        style="@style/BtnOutlineAccent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:text="@string/create_custom_exercise" />

    <!-- Empty state / prompt when no muscle selected -->
    <TextView
        android:id="@+id/tv_prompt"
        style="@style/TextMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
            android:text="@string/pick_muscle_prompt" />

    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        android:gravity="center"
        android:text="@string/no_exercises_match"
        android:textSize="13sp"
        android:textColor="@color/ink_3"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_exercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <include
        android:id="@+id/include_banner"
        layout="@layout/view_banner_ad" />
</LinearLayout>
