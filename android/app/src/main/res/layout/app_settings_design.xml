<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <include
        android:id="@+id/include_top_bar"
        layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_label" />

            <TextView
                style="@style/TextH1Serif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_header" />

            <!-- Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/name_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="@string/hint_your_name"
                    android:textColorHint="@color/ink_3"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Units -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/units_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <include
                    android:id="@+id/segmented_units"
                    layout="@layout/view_segmented_control" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Appearance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/appearance_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <include
                    android:id="@+id/segmented_appearance"
                    layout="@layout/view_segmented_control" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <TextView
                style="@style/TextKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reminder_label" />

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Reminder toggle -->
            <LinearLayout
                android:id="@+id/row_reminder_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_reminder_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_summary_off"
                        android:textSize="12sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Reminder time picker -->
            <LinearLayout
                android:id="@+id/row_reminder_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reminder_time_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/tv_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textSize="14sp"
                    android:textColor="@color/accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <TextView
                style="@style/TextKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy" />

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Privacy Policy -->
            <LinearLayout
                android:id="@+id/row_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/privacy_policy_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">"
                    android:textSize="14sp"
                    android:textColor="@color/ink_3" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <!-- Delete Account -->
            <LinearLayout
                android:id="@+id/row_delete_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/shape_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delete_account_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">"
                    android:textSize="14sp"
                    android:textColor="@color/ink_3" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" />

            <FrameLayout
                android:id="@+id/btn_sign_out"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_button_danger"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/sign_out"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/btn_text" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
